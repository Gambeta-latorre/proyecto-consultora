# Copiá estas variables en Vercel: Project > Settings > Environment Variables
# (nunca subas un archivo .env real al repositorio)

# Base de datos Postgres (Vercel Storage > Neon la agrega sola como DATABASE_URL)
DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require

# Ingreso con Google (Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx

# Emails que pueden entrar al panel /admin (separados por coma)
ADMIN_EMAILS=tu-correo@gmail.com

# Token de un solo uso para crear las tablas: /install?token=ESTE_VALOR  (borralo después)
SETUP_TOKEN=una-clave-larga-al-azar

# Datos bancarios que ve el cliente al pagar la seña (texto libre, varias líneas con \n)
BANK_INFO="Beneficiario: ...\nBanco: ...\nIBAN/CBU: ...\nSWIFT: ...\nReferencia: el código del pedido"

# Opcionales
# APP_URL=https://tu-dominio.com
# WHATSAPP_NUMBER=5491133486017
# APP_DEBUG=1
